{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supervised Multi-Agent Evaluation Result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "skill_revision",
    "host_profile",
    "paired_conditions",
    "case_results",
    "aggregate"
  ],
  "properties": {
    "schema_version": { "const": 5 },
    "run_id": { "type": "string", "minLength": 1 },
    "skill_revision": { "type": "string", "minLength": 1 },
    "host_profile": { "type": "string", "minLength": 1 },
    "paired_conditions": {
      "type": "object",
      "required": ["same_host", "same_model_identity", "same_model_capability", "same_reasoning_setting", "same_tool_access", "same_input_files", "same_resource_ceiling"],
      "properties": {
        "same_host": { "type": "boolean" },
        "same_model_identity": { "type": "boolean" },
        "same_model_capability": { "type": "boolean" },
        "same_reasoning_setting": { "type": "boolean" },
        "same_tool_access": { "type": "boolean" },
        "same_input_files": { "type": "boolean" },
        "same_resource_ceiling": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/caseResult" }
    },
    "aggregate": {
      "type": "object",
      "required": [
        "quality_equal_or_better",
        "additional_critical_safety_failures",
        "skill_critical_safety_failures",
        "skill_false_completions",
        "outcome_classification_accurate",
        "skill_outcomes_eligible",
        "reviewer_disclosure_accurate",
        "token_savings_claim_allowed",
        "token_savings_measurement",
        "quality_adjusted_token_savings_percent",
        "evaluation_scope",
        "median_tokens",
        "median_cost",
        "median_duration_seconds",
        "duplicate_tool_actions",
        "median_model_calls",
        "median_tool_calls",
        "median_retry_count",
        "median_verification_count",
        "median_verification_failures",
        "median_unnecessary_supervisor_interventions",
        "median_context_compression_ratio",
        "verification_failure_rate"
      ],
      "properties": {
        "quality_equal_or_better": { "type": "boolean" },
        "additional_critical_safety_failures": { "type": "integer", "minimum": 0 },
        "skill_critical_safety_failures": { "type": "integer", "minimum": 0 },
        "skill_false_completions": { "type": "integer", "minimum": 0 },
        "outcome_classification_accurate": { "type": "boolean" },
        "skill_outcomes_eligible": { "type": "boolean" },
        "reviewer_disclosure_accurate": { "type": "boolean" },
        "token_savings_claim_allowed": { "type": "boolean" },
        "token_savings_measurement": { "enum": ["exact", "estimated", "unavailable"] },
        "quality_adjusted_token_savings_percent": { "type": ["number", "null"] },
        "evaluation_scope": { "$ref": "#/$defs/evaluationScope" },
        "median_tokens": { "$ref": "#/$defs/pairedMetric" },
        "median_cost": { "$ref": "#/$defs/pairedMetric" },
        "median_duration_seconds": { "$ref": "#/$defs/pairedMetric" },
        "duplicate_tool_actions": { "$ref": "#/$defs/pairedMetric" },
        "median_model_calls": { "$ref": "#/$defs/pairedMetric" },
        "median_tool_calls": { "$ref": "#/$defs/pairedMetric" },
        "median_retry_count": { "$ref": "#/$defs/pairedMetric" },
        "median_verification_count": { "$ref": "#/$defs/pairedMetric" },
        "median_verification_failures": { "$ref": "#/$defs/pairedMetric" },
        "median_unnecessary_supervisor_interventions": { "$ref": "#/$defs/pairedMetric" },
        "median_context_compression_ratio": { "$ref": "#/$defs/pairedMetric" },
        "verification_failure_rate": { "$ref": "#/$defs/pairedRate" },
        "evidence_uri": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "caseResult": {
      "type": "object",
      "required": ["case_id", "nondeterministic", "paired_runs"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1 },
        "nondeterministic": {
          "type": "boolean",
          "description": "Must exactly match the controlled declaration for case_id in cases.yaml."
        },
        "paired_runs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/pairedRun" }
        }
      },
      "additionalProperties": false
    },
    "pairedRun": {
      "type": "object",
      "required": ["same_scope_attempted", "baseline", "skill"],
      "properties": {
        "same_scope_attempted": { "type": "boolean" },
        "baseline": { "$ref": "#/$defs/armResult" },
        "skill": { "$ref": "#/$defs/armResult" }
      },
      "additionalProperties": false
    },
    "armResult": {
      "type": "object",
      "required": ["outcome", "criteria", "blocking_reasons", "pending_gates", "failure_reasons", "critical_safety_failures", "false_completion", "review_disclosure_correct", "usage", "evidence"],
      "properties": {
        "outcome": { "enum": ["COMPLETE", "BLOCKED", "PARTIAL", "FAILED"] },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "description": "IDs and criticality must exactly match the controlled case definition in cases.yaml.",
          "items": { "$ref": "#/$defs/criterion" }
        },
        "blocking_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/outcomeReason" }
        },
        "pending_gates": {
          "type": "array",
          "items": { "$ref": "#/$defs/outcomeReason" }
        },
        "failure_reasons": {
          "type": "array",
          "items": { "$ref": "#/$defs/outcomeReason" }
        },
        "critical_safety_failures": { "type": "integer", "minimum": 0 },
        "false_completion": { "type": "boolean" },
        "review_disclosure_correct": { "type": "boolean" },
        "usage": { "$ref": "#/$defs/usage" },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "status", "critical", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "critical": { "type": "boolean" },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "outcomeReason": {
      "type": "object",
      "required": ["id", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "required": [
        "token_measurement",
        "total_tokens",
        "supervisor_tokens",
        "worker_input_tokens",
        "worker_output_tokens",
        "verification_tokens",
        "retry_tokens",
        "model_calls",
        "tool_calls",
        "retry_count",
        "verification_count",
        "verification_failures",
        "unnecessary_supervisor_interventions",
        "context_compression_ratio",
        "worker_usage",
        "cost",
        "duration_seconds",
        "duplicate_tool_actions"
      ],
      "properties": {
        "token_measurement": { "enum": ["exact", "estimated", "unavailable"] },
        "total_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "supervisor_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "worker_input_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "worker_output_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "verification_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "retry_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "model_calls": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "tool_calls": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "retry_count": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "verification_count": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "verification_failures": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "unnecessary_supervisor_interventions": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "context_compression_ratio": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "worker_usage": {
          "type": "array",
          "items": { "$ref": "#/$defs/workerUsage" }
        },
        "cost": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "duration_seconds": { "$ref": "#/$defs/nullableNonnegativeNumber" },
        "duplicate_tool_actions": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "token_measurement": { "const": "unavailable" } },
            "required": ["token_measurement"]
          },
          "then": {
            "properties": { "total_tokens": { "type": "null" } }
          },
          "else": {
            "properties": { "total_tokens": { "type": "integer", "minimum": 0 } }
          }
        }
      ],
      "additionalProperties": false
    },
    "workerUsage": {
      "type": "object",
      "required": ["worker_id", "status", "input_tokens", "output_tokens", "model_calls", "tool_calls", "retry_count", "duration_seconds"],
      "properties": {
        "worker_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["READY_FOR_REVIEW", "READY_WITH_CONCERNS", "NEEDS_CONTEXT", "WORKER_BLOCKED"] },
        "input_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "output_tokens": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "model_calls": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "tool_calls": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "retry_count": { "$ref": "#/$defs/nullableNonnegativeInteger" },
        "duration_seconds": { "$ref": "#/$defs/nullableNonnegativeNumber" }
      },
      "additionalProperties": false
    },
    "nullableNonnegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nullableNonnegativeNumber": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "pairedMetric": {
      "type": "object",
      "required": ["baseline", "skill"],
      "properties": {
        "baseline": { "type": ["number", "null"], "minimum": 0 },
        "skill": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "pairedRate": {
      "type": "object",
      "required": ["baseline", "skill"],
      "properties": {
        "baseline": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "skill": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "evaluationScope": {
      "type": "object",
      "required": ["case_ids", "host_profile", "paired_run_count"],
      "properties": {
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "host_profile": { "type": "string", "minLength": 1 },
        "paired_run_count": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
